      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/ReportFinding'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/ReportFinding'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/ReportFinding'
      security:
      - jwtAuth: []
      - BearerAuth: []
      responses:
        '201':
