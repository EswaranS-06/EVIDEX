            application/json:
              schema:
                $ref: '#/components/schemas/ReportFinding'
          description: ''
  /api/reports/{report_id}/findings/{id}/:
    get:
      operationId: reports_findings_retrieve
      description: Retrieve a finding
      parameters:
      - in: path
        name: id
        schema:
          type: integer
        required: true
      - in: path
        name: report_id
        schema:
          type: integer
        required: true
      tags:
      - reports
      security:
      - jwtAuth: []
      - BearerAuth: []
      responses:
